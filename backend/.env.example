# copy to .env and fill in real values. never commit .env.
# generate JWT_SECRET with: openssl rand -base64 64 | tr -d '\n'

SERVER_PORT=8080

# Database (local docker-compose postgres, or Supabase session pooler URL in prod)
DB_URL=jdbc:postgresql://localhost:5432/foodya
DB_USERNAME=postgres
DB_PASSWORD=changeme

# validate = schema managed by Flyway migrations only (recommended)
JPA_DDL_AUTO=validate

# Auth (BR-04): access 24h, refresh 30 days — in milliseconds
JWT_SECRET=changeme-generate-a-long-random-base64-string
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_SSL_ENABLED=false

# Web auth cookie (refresh token) + CORS — all optional, sensible defaults for local dev.
# Set COOKIE_SECURE=false only when testing over plain http://localhost.
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=Strict
# COOKIE_DOMAIN=
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL_JDBC=INFO
LOG_LEVEL_HIBERNATE_SQL=INFO