# Copy to .env and fill in real values. NEVER commit .env.
# Generate JWT_SECRET with: openssl rand -base64 64 | tr -d '\n'

SERVER_PORT=8080

# Database (local docker-compose Postgres, or Supabase pooler URL in prod)
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/foodya
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=changeme

# validate = schema managed by Flyway migrations only (recommended)
HIBERNATE_DDL_AUTO=validate

JWT_SECRET=changeme-generate-a-long-random-base64-string
# 24h / 30 days, in milliseconds (BR-04)
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000

REDIS_URL=redis://localhost:6379
REDIS_SSL_ENABLED=false

LOG_SPRING_JDBC=INFO
LOG_HIBERNATE_SQL=INFO
